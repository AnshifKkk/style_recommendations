# Copy this file to .env and fill in only what you need. .env is git-ignored; never commit real keys.
# Running the app (browsing predictions, styles, seasons and concepts) needs NONE of these.

# Optional: the AI assistant in the app, and the design step of concept generation.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only to render NEW concept images (python -m data_science.generate_concepts).
# Free Cloudflare account → Profile → API Tokens → "Workers AI" template; Account ID is in the dashboard URL.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional settings (defaults shown)
# IMAGES_ON_DEMAND=1          # fetch a missing article image from Kaggle when the app first shows it (needs `kaggle auth login`)
# IMAGE_URL_TEMPLATE=         # serve images from an image store instead, e.g. https://cdn.example.com/{prefix}/{article_id}.jpg
# VITE_API_URL=http://localhost:8000   # (frontend) where the app finds the API
